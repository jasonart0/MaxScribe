{
  "expo": {
    "name": "MaxScribe",
    "slug": "MaxScribe",
    "owner": "jasonart",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon copy.png",
    "scheme": "maxscribe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxremind.MaxScribeAI",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon copy.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.maxremind.MaxScribeAI"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record patient visit audio.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9FCFF"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "buildReactNativeFromSource": true,
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a093ea66-29b4-42a1-b7cb-d3e6b4209a9a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a093ea66-29b4-42a1-b7cb-d3e6b4209a9a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
