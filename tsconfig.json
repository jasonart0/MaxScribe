{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"jsx": "react",
		"strict": true,
		"paths": {
			"*": ["./app/*"],
			"@screens": ["./app/screens"],
			"@components": ["./app/components"],
			"@constants": ["./app/constants"],
			"@lib": ["./app/lib"],
			"@assets": ["./app/assets"],
			"@hooks": ["./app/hooks"]
		}
	},
	"include": ["App.tsx", "app/**/*.ts", "app/**/*.tsx", "app/**/*.js"],
	"exclude": ["node_modules", ".expo", "dist", "android", "ios"]
}
